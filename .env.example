# Server-only. Copy to .env.local; never share the completed file.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_PROVIDER=deepseek
SPEAKUP_DEMO=false
# Non-thinking short roleplay; feedback has a separate JSON output budget.
LLM_CHAT_MAX_TOKENS=400
LLM_FEEDBACK_MAX_TOKENS=1800
LLM_CHAT_TIMEOUT_MS=30000
LLM_FEEDBACK_TIMEOUT_MS=60000
# Optional absolute SQLite path. Default: ./data/speakup.sqlite
SPEAKUP_DB_PATH=
# Set true only for actual HTTPS hosting.
SPEAKUP_HTTPS=false
NEXT_TELEMETRY_DISABLED=1
